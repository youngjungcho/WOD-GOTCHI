const CATEGORIES := {
	"크로스핏": CROSSFIT, "운동 상식": EXERCISE, "영양": NUTRITION,
	"회복·수면": RECOVERY, "건강 상식": HEALTH, "부상 예방": INJURY,
}


static func total() -> int:
	var n := 0
	for c in CATEGORIES:
		n += (CATEGORIES[c] as Array).size()
	return n


## n개의 문제를 뽑는다. 서로 다른 분야에서 먼저 하나씩 고른다.
## 각 문제: {cat, q, options(섞인 보기), answer(정답 인덱스)}
static func pick(n: int) -> Array:
	var cats: Array = CATEGORIES.keys()
	cats.shuffle()
	var out := []
	var used := {}
	var k := 0
	while out.size() < n and k < 50:
		var cat: String = cats[k % cats.size()]
		k += 1
		var list: Array = CATEGORIES[cat]
		var qi := randi() % list.size()
		var key := "%s%d" % [cat, qi]
		if used.has(key):
			continue
		used[key] = true
		var qa: Array = list[qi]
		var opts: Array = (qa[1] as Array).duplicate()
		var right: String = opts[0]
		opts.shuffle()
		out.append({"cat": cat, "q": qa[0], "options": opts, "answer": opts.find(right)})
	return out

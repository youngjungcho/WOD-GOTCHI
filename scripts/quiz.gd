	["'칩퍼(Chipper)' WOD는?", ["여러 동작을 하나씩 깎아 나가기", "한 동작만 반복", "무게만 올리기"]],
	["버피의 기본 순서는?", ["엎드렸다 일어나 점프", "앉았다 일어나기만", "팔굽혀펴기만"]],
	["운동 후 회복에 가장 좋은 것은?", ["충분한 잠과 단백질", "매일 치팅", "잠 줄이기"]],
	["그립이 특히 중요한 동작은?", ["데드리프트·풀업", "에어 스쿼트", "달리기"]],
	["머슬업의 마지막 자세는?", ["바 위에서 팔을 펴 고정", "바에 매달리기", "바닥에 착지"]],
]


## n개의 문제를 뽑는다. 각 문제: {q, options(섞인 보기), answer(정답 인덱스)}
static func pick(n: int) -> Array:
	var idx := range(QUESTIONS.size())
	idx.shuffle()
	var out := []
	for i in mini(n, idx.size()):
		var qa: Array = QUESTIONS[idx[i]]
		var opts: Array = (qa[1] as Array).duplicate()
		var right: String = opts[0]
		opts.shuffle()
		out.append({"q": qa[0], "options": opts, "answer": opts.find(right)})
	return out

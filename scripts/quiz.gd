class_name Quiz
extends RefCounted
## 크로스핏 상식 퀴즈. 첫 번째 보기가 정답이고, 낼 때 보기 순서를 섞는다.

const QUESTIONS := [
	["WOD는 무엇의 줄임말?", ["Workout Of the Day", "World Of Dumbbells", "Weight On Deck"]],
	["AMRAP의 뜻은?", ["정해진 시간 동안 최대한 많이", "매 분 시작마다 정해진 횟수", "딱 한 번만 하기"]],
	["EMOM의 뜻은?", ["매 분 시작마다 정해진 동작", "끝날 때까지 쉬지 않기", "가장 무거운 무게 찾기"]],
	["For Time WOD의 목표는?", ["정해진 일을 최대한 빨리", "정해진 시간 동안 버티기", "최대 무게 들기"]],
	["'RX'로 했다는 건?", ["정해진 무게·동작 그대로", "무게를 낮춰서", "동작을 바꿔서"]],
	["1RM은?", ["한 번 들 수 있는 최대 무게", "1분 동안 한 횟수", "1라운드 기록"]],
	["PR은?", ["개인 최고 기록", "프로 선수 등급", "쉬는 시간"]],
	["'Fran'의 동작은?", ["쓰러스터와 풀업", "데드리프트와 박스점프", "로잉과 버피"]],
	["'Murph'에 없는 동작은?", ["쓰러스터", "1마일 달리기", "풀업"]],
	["'Cindy'는 풀업, 푸시업, 그리고?", ["에어 스쿼트", "버피", "월볼"]],
	["'Grace'는 클린앤저크 몇 회?", ["30회", "50회", "100회"]],
	["'Helen'은 달리기, KB 스윙, 그리고?", ["풀업", "쓰러스터", "박스점프"]],
	["더블 언더는?", ["한 번 점프에 줄이 두 바퀴", "두 번 점프에 줄이 한 바퀴", "줄 두 개로 하기"]],
	["키핑(kipping)은?", ["몸의 반동을 쓰는 기술", "바를 안 잡는 기술", "쉬는 시간"]],
	["T2B에서 발이 닿아야 하는 곳은?", ["바", "팔꿈치", "가슴"]],
	["C2B는 무엇이 바에 닿아야 할까?", ["가슴", "턱", "이마"]],
	["스쿼트 스내치에서 바를 받는 곳은?", ["머리 위", "어깨 앞", "허리"]],
	["클린의 '프론트 랙' 위치는?", ["어깨 앞", "머리 위", "등 뒤"]],
	["스쿼트 깊이 기준으로 흔히 쓰는 것은?", ["고관절이 무릎보다 아래", "무릎 90도 위", "엉덩이가 바닥에"]],
	["'스케일'한다는 뜻은?", ["내 수준에 맞게 조정", "무게를 재기", "기록 지우기"]],
	["메트콘(MetCon)은?", ["대사 컨디셔닝 운동", "금속 장비 이름", "체중 측정"]],
	["로잉에서 힘을 쓰는 순서는?", ["다리 → 몸통 → 팔", "팔 → 몸통 → 다리", "팔만 사용"]],
	["크로스핏에서 '박스'는?", ["크로스핏 체육관", "박스점프 기구만", "장비 보관함"]],
	["Tabata는 20초 운동 후 몇 초 휴식?", ["10초", "20초", "30초"]],
